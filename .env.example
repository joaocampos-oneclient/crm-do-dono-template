# Copie para .env.local. TUDO aqui é opcional: o CRM roda sem nenhuma variável (dados no navegador).

# ---------- Front (Vite) ----------
# Defina para o front falar com o servidor local (server/) em vez do localStorage.
# VITE_API_URL=http://localhost:8787
# Chave de escopo "escrita" (Operadores e chaves). A de exemplo funciona com os dados de exemplo.
# VITE_API_KEY=crm_escrita_exemplo_troque_esta_chave

# ---------- Servidor (server/) ----------
# PORT=8787
# Arquivo de persistência. "memoria" = não grava (some ao reiniciar).
# CRM_DADOS=server/data/crm.json
# Chave mestra de escrita, além das cadastradas no CRM. Use em webhooks de terceiros.
# CRM_API_KEY=
# Desliga a autenticação. SÓ em desenvolvimento local.
# CRM_SEM_AUTH=0
# URL pública da API (aparece nos textos de integração e no prompt do Grokbot).
# CRM_URL_PUBLICA=http://localhost:8787

# ---------- Cláudio com modelo de linguagem (opcional) ----------
# Sem LLM_API_KEY, o Cláudio responde por regras (src/domain/claudio.ts). Com, o modelo só redige.
# Qualquer endpoint compatível com a API de chat da OpenAI: OpenAI, Groq, xAI, OpenRouter, Ollama.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------- MCP (server/mcp.ts) ----------
# CRM_API_URL=http://localhost:8787
# CRM_API_KEY=crm_leitura_exemplo_troque_esta_chave   (leitura) ou crm_escrita_... (escrita)

# ---------- Banco de dados (quando ligar o Supabase; docs/banco-de-dados.md) ----------
# Nunca coloque a chave service_role no front-end.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=      (só no servidor)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
