# Copie para .env.local. Só o que você tem — o resto é opcional.
# Rode: npm run setup && npm run doctor

# --- Obrigatório para multiusuário / produção ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM dos agentes (Anthropic / Mastra) ---
# Sem chave: agentes usam regras locais (CRM funciona igual).
# Também dá para colar a chave em Integrações › Grokbot / agentes.
ANTHROPIC_API_KEY=
# Alias opcional (mesma chave):
# CRM_LLM_API_KEY=
# Modelo padrão barato/rápido:
# CRM_LLM_MODEL=claude-haiku-4-5
# Modelo forte dedicado ao Agente Ember / Relance (abertura de oportunidade):
# CRM_EMBER_MODEL=claude-sonnet-4-5
# Resposta automática do Cláudio no webhook após abertura (0 = só enfileira em Conversas/Hoje):
# CRM_CLAUDIO_AUTO_REPLY=0
# Segredo opcional para proteger o cron externo de /api/reciclador/tick:
# CRON_SECRET=
# Opcional: modelo rápido de decisão (Jev / TypeSafe)
JEV_API_KEY=
JEV_API_URL=

# --- MCP (Cursor / GrokBot). Demos locais já funcionam sem isso. ---
CRM_MCP_TOKEN_LEITURA=
CRM_MCP_TOKEN_ESCRITA=
CRM_MCP_TOKEN_ADMIN=
# Tokens de demo (só local): crm_demo_leitura | crm_demo_escrita | crm_demo_admin

# --- WhatsApp (padrão: WPP Engine) ---
# WHATSAPP_PROVIDER=wpp-engine
WPP_API_BASE_URL=https://wpp-engine.oneclient.com.br/v1
WPP_API_KEY=
WPP_SESSION_ID=
WPP_WEBHOOK_SECRET=
WPP_CONSOLE_URL=https://wpp-engine.oneclient.com.br
# Alternativa opcional (não use no caminho padrão):
# WHATSAPP_PROVIDER=waha
# WAHA_URL=http://localhost:3001
# WAHA_API_KEY=

# --- E-mail (Resend). Vários tokens = rodízio de domínio (em breve). ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Ligação (opcional, Twilio) ---
CRM_LIGACAO=0
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
