# Copie para .env.local. Só o que você tem — o resto é opcional.
# Rode: npm run setup && npm run doctor

# --- Obrigatório para multiusuário / produção ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM dos agentes (Anthropic) ---
ANTHROPIC_API_KEY=
# Opcional: modelo rápido de decisão (Jev / TypeSafe)
JEV_API_KEY=
JEV_API_URL=

# --- MCP (Cursor / GrokBot). Demos locais já funcionam sem isso. ---
CRM_MCP_TOKEN_LEITURA=
CRM_MCP_TOKEN_ESCRITA=
CRM_MCP_TOKEN_ADMIN=
# Tokens de demo (só local): crm_demo_leitura | crm_demo_escrita | crm_demo_admin

# --- WhatsApp (padrão: WPP Engine) ---
# WHATSAPP_PROVIDER=wpp-engine
WPP_API_BASE_URL=https://wpp-engine.oneclient.com.br/v1
WPP_API_KEY=
WPP_SESSION_ID=
WPP_WEBHOOK_SECRET=
WPP_CONSOLE_URL=https://wpp-engine.oneclient.com.br
# Alternativa opcional (não use no caminho padrão):
# WHATSAPP_PROVIDER=waha
# WAHA_URL=http://localhost:3001
# WAHA_API_KEY=

# --- E-mail (Resend). Vários tokens = rodízio de domínio (em breve). ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Ligação (opcional, Twilio) ---
CRM_LIGACAO=0
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
